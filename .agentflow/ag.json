{
  "schema-version": 13,
  "default-editor": "vscode",
  "next_update_date": "2026-11-05",
  "switches": {
    "ag-dir": ".agentflow",
    "auto-commit": "on",
    "auto-push": "on",
    "gate-design": "off",
    "gate-tracker": "off",
    "inline-reply": "on",
    "omit-asker": "on",
    "omit-run": "on",
    "omit-wip": "off",
    "plan-mode": "optional",
    "plan-order": "external",
    "review-order": "external",
    "saving-mode": "off",
    "use-lang": "en-us",
    "notebook-name": "esg-hackathon-bus-2026.devlog.md"
  },
  "pipeline-roles": {
    "requirements": "better",
    "codewalk": "better",
    "explore": "better",
    "spike": "better",
    "spec": "better",
    "implementation": "basic",
    "security-scan": "best",
    "//": "review \u4e5f\u662f\u7528 acceptance \u8a2d\u5b9a",
    "acceptance": "better",
    "learn": "basic",
    "threeways": "better",
    "product-docs": "better"
  },
  "model-family": {
    "openai": {
      "best": "gpt-6-astra/medium",
      "better": "gpt-6.1-sol/high",
      "basic": "gpt-6.1-sol/low",
      "cheap": "gpt-6-luna/high"
    },
    "claude": {
      "best": "claude-opus-5-5/high",
      "better": "claude-opus-5-5/medium",
      "basic": "claude-sonnet-5-5/medium",
      "cheap": "claude-haiku-5-5/medium"
    }
  },
  "external-workers": [
    {
      "id": "codex-default",
      "command": [
        "codex",
        "exec"
      ],
      "priority": 3,
      "model-family": "openai"
    },
    {
      "id": "claude-default",
      "command": [
        "claude",
        "-p"
      ],
      "priority": 3,
      "model-family": "claude"
    }
  ],
  "looper-routes": {
    "task": {
      "kind": "cli",
      "provider": "codex",
      "model-family": "openai"
    },
    "repair": {
      "kind": "cli",
      "provider": "codex",
      "model-family": "openai"
    },
    "acceptance": {
      "kind": "cli",
      "provider": "codex",
      "model-family": "openai"
    }
  },
  "looper-limits": {
    "max-workers": 3,
    "max-repairs": 2
  }
}
